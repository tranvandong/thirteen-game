{
  "name": "thirteen-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"react-router dev --host\" \"tsx watch server/index.ts\"",
    "build": "react-router build && tsup server/index.ts --format esm --out-dir dist",
    "start": "node dist/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/roboto": "^5.2.10",
    "@react-router/express": "^7.17.0",
    "@react-router/node": "7.16.0",
    "@react-router/serve": "7.16.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "http": "^0.0.1-security",
    "isbot": "^5.1.36",
    "lucide-react": "^1.17.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.16.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.10.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-router/dev": "7.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
