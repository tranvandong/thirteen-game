# ── App ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname
PROD=false

# ── AI / TTS (tuỳ chọn) ──────────────────────────────────────────
GEMINI_KEY=
TTS_API_URL=https://www.everai.vn/api/v1/tts
TTS_API_KEY=
ELEVENLABS_API_KEY=

# ── Web Push (VAPID) ─────────────────────────────────────────────
# Sinh cặp khoá bằng:  npx web-push generate-vapid-keys
# Client (Vite) dùng VITE_VAPID_PUBLIC_KEY để subscribe.
# Server dùng VAPID_PRIVATE_KEY để ký gửi push.
# Phải là CÙNG 1 cặp khoá.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@thirteen.game
